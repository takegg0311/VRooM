# docker compose で起動する場合、値が空の項目には Firebase Emulator 用の既定値が使われる
# （docker-compose.yml の environment を参照）。ローカルで動かすだけなら記入は不要。

# true: ローカルの Firebase Emulator に接続する / false: 下記の実プロジェクトに接続する
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=

# 実際の Firebase プロジェクトを使う場合の設定（Firebase コンソール > プロジェクトの設定 > マイアプリ から取得）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# 「テストアカウントでログイン」で使うアカウント（エミュレータでは起動時に自動作成される）
NEXT_PUBLIC_FIREBASE_TEST_ACCOUNT_EMAIL=
NEXT_PUBLIC_FIREBASE_TEST_ACCOUNT_PASSWORD=
